"""Generated from a BESSER D3 circuit. Regenerate from the model to make changes."""

from qiskit import QuantumCircuit, QuantumRegister, ClassicalRegister, transpile
from qiskit.circuit.library import HGate, XGate, ZGate, PhaseGate, QFT
from qiskit_aer import AerSimulator


def build_circuit():
    q = QuantumRegister({{ circuit.num_qubits }}, "q")
    c = ClassicalRegister({{ circuit.num_clbits }}, "c")
    qc = QuantumCircuit(q, c)
{% for operation in operations_code %}
    {{ operation }}
{% endfor %}
    return qc


def run(*, seed=None):
    simulator = AerSimulator(max_parallel_threads=1)
    circuit = transpile(build_circuit(), simulator, seed_transpiler=seed)
    return simulator.run(circuit, shots={{ shots }}, seed_simulator=seed).result().get_counts()


if __name__ == "__main__":
    print(run())
