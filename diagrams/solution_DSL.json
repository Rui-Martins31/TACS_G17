                "bounds": {
                  "x": 390,
                  "y": -410,
                  "width": 160,
                  "height": 100
                },
                "description": "Following parent links must never return to the same constraint.",
                "constraint": "context ConstraintExpression inv acyclicConstraints: self.parent->closure(p | p.parent)->excludes(self)"
              },
              "e9afce81-e3ac-4582-9ec7-c8eaaef93540": {
