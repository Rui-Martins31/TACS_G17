                "bounds": {
                  "x": 130,
                  "y": -450,
                  "width": 160,
                  "height": 100
                },
                "description": "A constraint is either a problem’s root or another constraint’s operand, exclusively.",
                "constraint": "context ConstraintExpression inv constraintOwner: self.rootProblem->size() + self.parent->size() = 1"
              },
              "f7ae5223-0552-4cba-bb9c-cf1152f153a7": {
                "id": "f7ae5223-0552-4cba-bb9c-cf1152f153a7",
