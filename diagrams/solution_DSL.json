              },
              "bd61b080-9332-4e83-95dd-da2bebb7c072": {
                "id": "bd61b080-9332-4e83-95dd-da2bebb7c072",
                "name": "",
                "type": "ClassOCLConstraint",
                "owner": null,
                "bounds": {
                  "x": -610,
                  "y": 120,
                  "width": 160,
                  "height": 100
                },
                "description": "Every referenced variable belongs to the same problem as the expression.",
                "constraint": "context LinearExpression inv variablesWithinProblem: let containers : Set(ConstraintExpression) = self.atom->collect(a | a.oclAsType(ConstraintExpression))->asSet() in let owners : Set(ILPProblem) = self.objectiveProblem->asSet()->union(containers->union(containers->closure(c | c.parent))->collect(c | c.rootProblem)->flatten()->excluding(null)->asSet()) in owners->size() = 1 and self.terms->forAll(t | owners->forAll(p | p.variables->includes(t.variable)))"
              }
